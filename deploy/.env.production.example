# Production settings for the server. Copy to /home/ubuntu/portfolio-site/.env and `chmod 600 .env`.
# Never commit the filled-in file. Fill the empty values on the server:
#   STATS_TOKEN:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   IP_HASH_SALT: python3 -c "import secrets; print(secrets.token_hex(32))"

# Anthropic API key. Server-side only.
ANTHROPIC_API_KEY=

LLM_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-5-5
FIT_MODEL=claude-sonnet-5-5

# production: disables /api/search and the eval bypass. There is deliberately NO EVAL_TOKEN here.
APP_ENV=production

DAILY_SPEND_CAP_USD=0.50
RATE_LIMIT_CHAT_PER_HOUR=15
RATE_LIMIT_FIT_PER_HOUR=5

# Fresh values for this server (see the commands above).
STATS_TOKEN=
IP_HASH_SALT=

# One trusted proxy (Caddy) in front of the app. docker-compose.yml sets these too.
TRUSTED_PROXY_HOPS=1
CLIENT_IP_HEADER=
LOG_DIR=/data/logs

# Optional GitHub token with NO scopes, only to raise the public API rate limit.
GITHUB_TOKEN=
