# Copy to .env and fill in. .env is git-ignored and never sent to the browser.

# Anthropic API key (console.anthropic.com). Server-side only.
ANTHROPIC_API_KEY=

# Model provider + model names. Swap these to try another provider later
# (e.g. LLM_PROVIDER=openai_compatible with a Groq/OpenRouter base URL).
LLM_PROVIDER=anthropic
CHAT_MODEL=claude-haiku-5-5
FIT_MODEL=claude-sonnet-5-5

# "development" enables dev-only endpoints such as /api/search. Use "production" when deployed.
APP_ENV=development

# ── Public-safety settings (Step 6) ──
# Daily model spend cap in USD (UTC day). When reached, the widget shows "come back tomorrow".
DAILY_SPEND_CAP_USD=0.50
# Per-visitor limits (requests per hour).
RATE_LIMIT_CHAT_PER_HOUR=15
RATE_LIMIT_FIT_PER_HOUR=5
# Secret salt for hashing visitor IPs (HMAC). Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
IP_HASH_SALT=
# Token for GET /api/stats (send as "Authorization: Bearer <token>"). Leave blank to disable the endpoint.
STATS_TOKEN=
# Number of trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For (local dev).
TRUSTED_PROXY_HOPS=0
# Token for the local eval suite (run_evals.py). Works only with APP_ENV=development, from localhost.
EVAL_TOKEN=
# Daily budget for eval runs (USD). Separate from DAILY_SPEND_CAP_USD, which only counts public traffic.
EVAL_DAILY_CAP_USD=1.00
